<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ report_title }}</title>
  <style>
    :root {
      --bg: #f7f7f8;
      --surface: #ffffff;
      --surface-subtle: #fafafa;
      --code-bg: #f4f4f5;
      --border: #e4e4e7;
      --border-strong: #d4d4d8;
      --text: #18181b;
      --text-secondary: #3f3f46;
      --text-muted: #71717a;

      --pass-bg: #ecfdf5;
      --pass-border: #bbf7d0;
      --pass-text: #166534;

      --fail-bg: #fef2f2;
      --fail-border: #fecaca;
      --fail-text: #991b1b;
      --fail-accent: #dc2626;

      --warn-bg: #fffbeb;
      --warn-border: #fde68a;
      --warn-text: #92400e;
      --warn-accent: #d97706;

      --info-bg: #f4f4f5;
      --info-border: #e4e4e7;
      --info-text: #27272a;

      --mock-bg: #eef2ff;
      --mock-border: #c7d2fe;
      --mock-text: #3730a3;

      --replay-bg: #f0f9ff;
      --replay-border: #bae6fd;
      --replay-text: #075985;

      --shadow-sm: 0 1px 2px rgba(24, 24, 27, 0.04);
      --mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      --sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Microsoft YaHei", sans-serif;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: var(--sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
      padding: 36px 24px 72px;
    }

    .container {
      max-width: 1280px;
      margin: 0 auto;
    }

    .header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 24px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--border);
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--text-muted);
      font-weight: 600;
      margin-bottom: 8px;
    }

    .brand-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--text);
      display: inline-block;
    }

    h1 {
      margin: 0;
      font-size: 24px;
      font-weight: 650;
      letter-spacing: -0.02em;
      color: var(--text);
    }

    .subtitle {
      margin-top: 6px;
      color: var(--text-muted);
      font-size: 13px;
    }

    .header-badges {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      align-items: center;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 9px;
      border-radius: 6px;
      font-size: 11.5px;
      font-weight: 600;
      letter-spacing: 0.02em;
      white-space: nowrap;
      border: 1px solid transparent;
    }

    .badge-pass {
      background: var(--pass-bg);
      color: var(--pass-text);
      border-color: var(--pass-border);
    }

    .badge-fail {
      background: var(--fail-bg);
      color: var(--fail-text);
      border-color: var(--fail-border);
    }

    .badge-warn {
      background: var(--warn-bg);
      color: var(--warn-text);
      border-color: var(--warn-border);
    }

    .badge-info {
      background: var(--info-bg);
      color: var(--info-text);
      border-color: var(--info-border);
    }

    .badge-mocked {
      background: var(--mock-bg);
      color: var(--mock-text);
      border-color: var(--mock-border);
    }

    .badge-replayed {
      background: var(--replay-bg);
      color: var(--replay-text);
      border-color: var(--replay-border);
    }

    .badge-fork {
      background: var(--warn-bg);
      color: var(--warn-text);
      border-color: var(--warn-border);
    }

    .step-badges {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      align-items: center;
    }

    .context-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
      margin-bottom: 20px;
    }

    .context-grid.two-col {
      grid-template-columns: 1fr 1fr;
    }

    .task-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 14px 16px;
      box-shadow: var(--shadow-sm);
      font-size: 13.5px;
      color: var(--text-secondary);
    }

    .task-label {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-muted);
      margin-bottom: 6px;
    }

    .task-content {
      color: var(--text);
      white-space: pre-wrap;
      word-break: break-word;
    }

    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 12px;
      margin-bottom: 20px;
    }

    .metric-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px 18px;
      box-shadow: var(--shadow-sm);
    }

    .metric-card.alert {
      border-color: var(--fail-border);
      border-top: 2px solid var(--fail-accent);
    }

    .metric-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-muted);
      font-weight: 600;
      margin-bottom: 8px;
    }

    .metric-value {
      font-size: 24px;
      font-weight: 650;
      line-height: 1.2;
      color: var(--text);
      font-variant-numeric: tabular-nums;
      letter-spacing: -0.02em;
    }

    .metric-value-muted {
      font-size: 14px;
      font-weight: 500;
      color: var(--text-muted);
    }

    .metric-sub {
      margin-top: 6px;
      font-size: 12.5px;
      color: var(--text-muted);
      font-variant-numeric: tabular-nums;
    }

    .section {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 20px;
      margin-bottom: 20px;
      box-shadow: var(--shadow-sm);
    }

    .section-header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin-bottom: 16px;
    }

    .section-title {
      margin: 0;
      font-size: 15.5px;
      font-weight: 650;
      color: var(--text);
      letter-spacing: -0.01em;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13.5px;
    }

    th, td {
      text-align: left;
      padding: 10px 12px;
      border-bottom: 1px solid var(--border);
      vertical-align: top;
    }

    th {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-muted);
      font-weight: 600;
      background: var(--surface-subtle);
    }

    tbody tr:hover {
      background: var(--surface-subtle);
    }

    tr:last-child td {
      border-bottom: none;
    }

    code {
      font-family: var(--mono);
      font-size: 12.5px;
      background: var(--code-bg);
      padding: 2px 6px;
      border-radius: 4px;
      color: var(--text);
    }

    .toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .btn {
      background: var(--surface);
      color: var(--text-secondary);
      border: 1px solid var(--border);
      border-radius: 7px;
      padding: 5px 11px;
      font-size: 12.5px;
      font-weight: 500;
      cursor: pointer;
      transition: background-color 0.12s ease, border-color 0.12s ease, color 0.12s ease;
    }

    .btn:hover {
      background: var(--surface-subtle);
      border-color: var(--border-strong);
      color: var(--text);
    }

    .btn.active {
      background: var(--text);
      border-color: var(--text);
      color: #ffffff;
    }

    .diff-columns-header {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-bottom: 14px;
    }

    .lane-banner {
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 10px 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      font-size: 13px;
    }

    .timeline-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-bottom: 12px;
    }

    .timeline-row.single-col {
      grid-template-columns: 1fr;
    }

    .timeline-row.hidden {
      display: none;
    }

    .timeline-row.fork-point {
      padding: 12px;
      border: 1px solid var(--warn-border);
      border-left: 3px solid var(--warn-accent);
      background: #fffdf7;
      border-radius: 10px;
    }

    .fork-banner {
      grid-column: 1 / -1;
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      padding: 7px 12px;
      border-radius: 6px;
      background: var(--warn-bg);
      border: 1px solid var(--warn-border);
      color: var(--warn-text);
      font-weight: 650;
      font-size: 12px;
      letter-spacing: 0.03em;
    }

    .fork-banner .fork-detail {
      color: var(--text-secondary);
      font-weight: 500;
      letter-spacing: normal;
    }

    .step-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 14px;
      transition: border-color 0.15s ease;
    }

    .step-card.diverged {
      border-color: var(--fail-border);
      border-left: 3px solid var(--fail-accent);
      background: #fffafa;
    }

    .step-card.args-diff {
      border-color: var(--warn-border);
      border-left: 3px solid var(--warn-accent);
    }

    .step-card.empty-slot {
      background: var(--surface-subtle);
      border-style: dashed;
      border-color: var(--border-strong);
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 82px;
      color: var(--text-muted);
      font-size: 12.5px;
    }

    .step-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 8px;
    }

    .step-id {
      font-weight: 600;
      font-size: 13.5px;
      color: var(--text);
    }

    .step-meta {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      font-size: 12px;
      color: var(--text-muted);
      margin-bottom: 10px;
      font-family: var(--mono);
      font-variant-numeric: tabular-nums;
    }

    details {
      border-top: 1px solid var(--border);
      padding-top: 8px;
    }

    summary {
      cursor: pointer;
      font-size: 12.5px;
      font-weight: 500;
      color: var(--text-secondary);
      user-select: none;
    }

    summary:hover {
      color: var(--text);
    }

    .detail-block {
      margin-top: 10px;
    }

    .detail-label {
      font-size: 10.5px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-muted);
      margin-bottom: 4px;
    }

    .thought-box {
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 9px 11px;
      font-size: 13px;
      color: var(--text-secondary);
      white-space: pre-wrap;
    }

    pre {
      margin: 0;
      background: var(--code-bg);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 9px 11px;
      font-family: var(--mono);
      font-size: 12px;
      color: var(--text);
      overflow-x: auto;
      white-space: pre-wrap;
      word-break: break-word;
    }

    @media (max-width: 900px) {
      .context-grid.two-col,
      .diff-columns-header,
      .timeline-row {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  {% macro obs_badges(obs) -%}
    {% if obs and obs.is_mocked %}<span class="badge badge-mocked" title="Observation served by ToolSandbox">[MOCKED 🛡️]</span>{% endif %}
    {% if obs and obs.is_replayed %}<span class="badge badge-replayed" title="Observation replayed from baseline history">[REPLAYED ⏪]</span>{% endif %}
    {% if obs and obs.is_error %}<span class="badge badge-fail" title="Tool raised an exception">{{ obs.error_type or 'ERROR' }}</span>{% endif %}
  {%- endmacro %}
  {% macro fork_banner(step_id, is_fork, is_divergence) -%}
    <div class="fork-banner">
      <span>[FORK / DIVERGENCE POINT ⚡]</span>
      <span class="fork-detail">
        Step {{ step_id }}
        {% if is_fork %}&bull; fork replay starts here (history unlocked){% endif %}
        {% if is_divergence %}&bull; first state / tool divergence vs baseline{% endif %}
      </span>
    </div>
  {%- endmacro %}
  <div class="container">
    <header class="header">
      <div>
        <div class="brand">
          <span class="brand-dot"></span>
          Agent-Probe &bull; White-Box Trajectory Report
        </div>
        <h1>{{ report_title }}</h1>
        <div class="subtitle">
          Local-first self-contained inspection &amp; assertion report
          {% if fork_step_id is not none %}
            &bull; Fork Replay @ Step {{ fork_step_id }}
          {% endif %}
          {% if has_mocked_steps %}
            &bull; Sandbox Mocked
          {% endif %}
        </div>
      </div>
      <div class="header-badges">
        {% if has_mocked_steps %}
          <span class="badge badge-mocked">[MOCKED 🛡️]</span>
        {% endif %}
        {% if has_replayed_steps %}
          <span class="badge badge-replayed">[REPLAYED ⏪]</span>
        {% endif %}
        {% if primary_report %}
          {% if primary_report.overall_passed %}
            <span class="badge badge-pass">EVAL PASSED ({{ "%.1f"|format(primary_report.overall_score * 100) }}%)</span>
          {% else %}
            <span class="badge badge-fail">EVAL FAILED ({{ "%.1f"|format(primary_report.overall_score * 100) }}%)</span>
          {% endif %}
        {% elif diff %}
          {% if diff.divergence_step_id is not none %}
            <span class="badge badge-fail">DIVERGED @ STEP {{ diff.divergence_step_id }}</span>
          {% else %}
            <span class="badge badge-pass">TRAJECTORIES ALIGNED</span>
          {% endif %}
        {% endif %}
      </div>
    </header>

    <div class="context-grid">
      <div class="task-box">
        <div class="task-label"><span>Task Input</span></div>
        <div class="task-content">{{ task_input }}</div>
      </div>
    </div>

    {% if diff and (baseline.final_output is not none or candidate.final_output is not none) %}
      <div class="context-grid two-col">
        <div class="task-box">
          <div class="task-label">
            <span>Baseline Final Output</span>
            <span class="badge {% if baseline.status == 'SUCCESS' %}badge-pass{% else %}badge-fail{% endif %}">{{ baseline.status }}</span>
          </div>
          <div class="task-content">{{ baseline.final_output if baseline.final_output is not none else '<none>' }}</div>
        </div>
        <div class="task-box">
          <div class="task-label">
            <span>Candidate Final Output</span>
            <span class="badge {% if candidate.status == 'SUCCESS' %}badge-pass{% else %}badge-fail{% endif %}">{{ candidate.status }}</span>
          </div>
          <div class="task-content">{{ candidate.final_output if candidate.final_output is not none else '<none>' }}</div>
        </div>
      </div>
    {% elif single_trace and single_trace.final_output is not none %}
      <div class="context-grid">
        <div class="task-box">
          <div class="task-label">
            <span>Final Output</span>
            <span class="badge {% if single_trace.status == 'SUCCESS' %}badge-pass{% else %}badge-fail{% endif %}">{{ single_trace.status }}</span>
          </div>
          <div class="task-content">{{ single_trace.final_output }}</div>
        </div>
      </div>
    {% endif %}

    <section class="metrics-grid">
      {% if primary_report %}
        <div class="metric-card {% if not primary_report.overall_passed %}alert{% endif %}">
          <div class="metric-label">{% if diff %}Candidate Eval Score{% else %}Evaluation Score{% endif %}</div>
          <div class="metric-value">{{ "%.1f"|format(primary_report.overall_score * 100) }}%</div>
          <div class="metric-sub">
            {{ passed_count }} / {{ primary_report.assertions|length }} assertions passed
            {% if baseline_report %}
              &bull; Baseline: {{ "%.1f"|format(baseline_report.overall_score * 100) }}%
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if diff %}
        <div class="metric-card">
          <div class="metric-label">Total Steps Comparison</div>
          <div class="metric-value">{{ candidate.total_steps }} <span class="metric-value-muted">vs {{ baseline.total_steps }}</span></div>
          <div class="metric-sub">Step delta: {{ "%+d"|format(diff.step_delta) }}</div>
        </div>

        <div class="metric-card {% if diff.token_delta > 0 %}alert{% endif %}">
          <div class="metric-label">Token Consumption &amp; Change</div>
          <div class="metric-value">{{ candidate.total_tokens }} <span class="metric-value-muted">vs {{ baseline.total_tokens }}</span></div>
          <div class="metric-sub">Delta: {{ "%+d"|format(diff.token_delta) }} ({{ "%+.1f"|format(token_change_pct) }}%)</div>
        </div>

        <div class="metric-card">
          <div class="metric-label">Latency Comparison</div>
          <div class="metric-value">{{ "%.1f"|format(candidate.total_latency_ms) }} ms</div>
          <div class="metric-sub">Baseline: {{ "%.1f"|format(baseline.total_latency_ms) }} ms ({{ "%+.1f"|format(diff.latency_delta_ms) }} ms)</div>
        </div>

        <div class="metric-card {% if diff.divergence_step_id is not none %}alert{% endif %}">
          <div class="metric-label">First Divergence Point</div>
          <div class="metric-value">
            {% if diff.divergence_step_id is not none %}
              Step {{ diff.divergence_step_id }}
            {% else %}
              None
            {% endif %}
          </div>
          <div class="metric-sub">
            {% if diff.divergence_step_id is not none %}
              First state or tool divergence detected
            {% else %}
              All states &amp; tool calls aligned
            {% endif %}
          </div>
        </div>

        {% if fork_step_id is not none or has_mocked_steps or has_replayed_steps %}
          <div class="metric-card">
            <div class="metric-label">{% if fork_step_id is not none %}Fork Replay Point{% else %}Sandbox Coverage{% endif %}</div>
            <div class="metric-value">
              {% if fork_step_id is not none %}Step {{ fork_step_id }}{% else %}Active{% endif %}
            </div>
            <div class="metric-sub">
              {{ replayed_count }} replayed &bull; {{ mocked_count }} mocked candidate
              {% if baseline_mocked_count > 0 %}
                &bull; {{ baseline_mocked_count }} mocked baseline
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% else %}
        <div class="metric-card">
          <div class="metric-label">Total Steps</div>
          <div class="metric-value">{{ single_trace.total_steps }}</div>
          <div class="metric-sub">Status: {{ single_trace.status }}</div>
        </div>
        <div class="metric-card">
          <div class="metric-label">Total Tokens</div>
          <div class="metric-value">{{ single_trace.total_tokens }}</div>
          <div class="metric-sub">Agent: {{ single_trace.agent_version }}</div>
        </div>
        <div class="metric-card">
          <div class="metric-label">Total Latency</div>
          <div class="metric-value">{{ "%.1f"|format(single_trace.total_latency_ms) }} ms</div>
          <div class="metric-sub">Trace: {{ single_trace.trace_id }}</div>
        </div>
        {% if fork_step_id is not none or has_mocked_steps or has_replayed_steps %}
          <div class="metric-card">
            <div class="metric-label">{% if fork_step_id is not none %}Fork Replay Point{% else %}Sandbox Coverage{% endif %}</div>
            <div class="metric-value">
              {% if fork_step_id is not none %}Step {{ fork_step_id }}{% else %}Active{% endif %}
            </div>
            <div class="metric-sub">
              {{ replayed_count }} replayed &bull; {{ mocked_count }} mocked steps
            </div>
          </div>
        {% endif %}
      {% endif %}
    </section>

    {% if primary_report %}
      <section class="section">
        <div class="section-header">
          <h2 class="section-title">
            Assertion Details ({{ primary_report.trace_id }})
          </h2>
          {% if baseline_report %}
            <span class="badge {% if baseline_report.overall_passed %}badge-pass{% else %}badge-fail{% endif %}">
              Baseline Suite: {{ "PASS" if baseline_report.overall_passed else "FAIL" }} ({{ "%.1f"|format(baseline_report.overall_score * 100) }}%)
            </span>
          {% endif %}
        </div>
        <table>
          <thead>
            <tr>
              <th>Rule</th>
              <th>Status</th>
              <th>Score</th>
              <th>Failed Steps</th>
              <th>Reason</th>
            </tr>
          </thead>
          <tbody>
            {% for item in primary_report.assertions %}
              <tr>
                <td><code>{{ item.rule_name }}</code></td>
                <td>
                  {% if item.passed %}
                    <span class="badge badge-pass">PASS</span>
                  {% else %}
                    <span class="badge badge-fail">FAIL</span>
                  {% endif %}
                </td>
                <td>{{ "%.2f"|format(item.score) }}</td>
                <td>
                  {% if item.failed_step_ids %}
                    <span class="badge badge-fail">Steps {{ item.failed_step_ids|join(", ") }}</span>
                  {% else %}
                    <span style="color:var(--text-muted)">-</span>
                  {% endif %}
                </td>
                <td>{{ item.reason }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </section>
    {% endif %}

    <section class="section">
      <div class="section-header">
        <h2 class="section-title">
          {% if diff %}Baseline vs Candidate Trajectory Timeline Diff{% else %}Execution Trajectory Timeline{% endif %}
        </h2>
        <div class="toolbar">
          <button type="button" class="btn active" id="btn-filter-all" onclick="filterRows('all')">All Steps</button>
          <button type="button" class="btn" id="btn-filter-issues" onclick="filterRows('issues')">Diverged / Failed</button>
          {% if has_mocked_steps %}
            <button type="button" class="btn" id="btn-filter-mocked" onclick="filterRows('mocked')">Mocked</button>
          {% endif %}
          {% if has_replayed_steps %}
            <button type="button" class="btn" id="btn-filter-replayed" onclick="filterRows('replayed')">Replayed</button>
          {% endif %}
          {% if has_fork_point %}
            <button type="button" class="btn" id="btn-filter-fork" onclick="filterRows('fork')">Fork Point</button>
          {% endif %}
          <button type="button" class="btn" onclick="toggleAllDetails(true)">Expand All</button>
          <button type="button" class="btn" onclick="toggleAllDetails(false)">Collapse All</button>
        </div>
      </div>

      {% if diff %}
        <div class="diff-columns-header">
          <div class="lane-banner">
            <div>
              <strong>Baseline:</strong> {{ baseline.trace_id }}
              <span style="color:var(--text-muted)">({{ baseline.agent_version }})</span>
            </div>
            <span class="badge {% if baseline.status == 'SUCCESS' %}badge-pass{% else %}badge-fail{% endif %}">{{ baseline.status }}</span>
          </div>
          <div class="lane-banner">
            <div>
              <strong>Candidate:</strong> {{ candidate.trace_id }}
              <span style="color:var(--text-muted)">({{ candidate.agent_version }})</span>
              {% if candidate.fork_step_id is not none %}
                <span class="badge badge-fork">forked from {{ candidate.parent_trace_id or baseline.trace_id }} @ step {{ candidate.fork_step_id }}</span>
              {% endif %}
            </div>
            <span class="badge {% if candidate.status == 'SUCCESS' %}badge-pass{% else %}badge-fail{% endif %}">{{ candidate.status }}</span>
          </div>
        </div>

        {% for row in timeline_rows %}
          <div class="timeline-row {% if row.is_highlight_point %}fork-point{% endif %}"
               data-has-issue="{{ 'true' if row.has_issue or row.is_highlight_point else 'false' }}"
               data-is-mocked="{{ 'true' if row.is_mocked else 'false' }}"
               data-is-replayed="{{ 'true' if row.is_replayed else 'false' }}"
               data-is-fork="{{ 'true' if row.is_fork_point else 'false' }}">
            {% if row.is_highlight_point %}
              {{ fork_banner(row.step_id, row.is_fork_point, row.is_first_divergence) }}
            {% endif %}
            {% if row.baseline %}
              <div class="step-card">
                <div class="step-top">
                  <span class="step-id">Step {{ row.baseline.step_id }} &bull; {{ row.baseline.state }}</span>
                  <div class="step-badges">
                    {% if row.baseline.tool_name %}
                      <span class="badge badge-info">{{ row.baseline.tool_name }}</span>
                    {% else %}
                      <span class="badge badge-pass">NO TOOL</span>
                    {% endif %}
                    {{ obs_badges(row.baseline.observation) }}
                  </div>
                </div>
                <div class="step-meta">
                  <span>tokens: {{ row.baseline.tokens.total_tokens }}</span>
                  <span>latency: {{ "%.1f"|format(row.baseline.latency_ms) }} ms</span>
                </div>
                <details {% if row.has_issue %}open{% endif %}>
                  <summary>Inspect thought, arguments &amp; observation</summary>
                  {% if row.baseline.thought %}
                    <div class="detail-block">
                      <div class="detail-label">Thought</div>
                      <div class="thought-box">{{ row.baseline.thought }}</div>
                    </div>
                  {% endif %}
                  {% if row.baseline.tool_name %}
                    <div class="detail-block">
                      <div class="detail-label">Action Arguments</div>
                      <pre>{{ row.baseline.arguments_pretty }}</pre>
                    </div>
                  {% endif %}
                  {% if row.baseline.observation %}
                    <div class="detail-block">
                      <div class="detail-label">
                        Observation
                        {% if row.baseline.observation.is_error %}({{ row.baseline.observation.error_type or 'ERROR' }}){% endif %}
                        {% if row.baseline.observation.is_mocked %}(MOCKED){% endif %}
                      </div>
                      <pre>{{ row.baseline.observation_pretty }}</pre>
                    </div>
                  {% endif %}
                </details>
              </div>
            {% else %}
              <div class="step-card empty-slot">No corresponding Baseline step</div>
            {% endif %}

            {% if row.candidate %}
              <div class="step-card {% if row.is_diverged or row.is_candidate_failed %}diverged{% elif row.status == 'ARGS_DIFF' %}args-diff{% endif %}">
                <div class="step-top">
                  <span class="step-id">Step {{ row.candidate.step_id }} &bull; {{ row.candidate.state }}</span>
                  <div class="step-badges">
                    {% if row.candidate.tool_name %}
                      <span class="badge badge-info">{{ row.candidate.tool_name }}</span>
                    {% endif %}
                    {% if row.is_first_divergence %}
                      <span class="badge badge-fail">FIRST DIVERGENCE</span>
                    {% elif row.is_diverged %}
                      <span class="badge badge-fail">{{ row.status }}</span>
                    {% elif row.status == 'ARGS_DIFF' %}
                      <span class="badge badge-warn">ARGS DIFF</span>
                    {% else %}
                      <span class="badge badge-pass">MATCH</span>
                    {% endif %}
                    {% if row.is_loop_step %}
                      <span class="badge badge-fail">LOOP DETECTED</span>
                    {% elif row.is_candidate_failed %}
                      <span class="badge badge-fail">ASSERTION FAIL</span>
                    {% endif %}
                    {% if row.is_fork_point %}
                      <span class="badge badge-fork">FORK POINT ⚡</span>
                    {% endif %}
                    {{ obs_badges(row.candidate.observation) }}
                  </div>
                </div>
                <div class="step-meta">
                  <span>tokens: {{ row.candidate.tokens.total_tokens }} ({{ "%+d"|format(row.token_delta) }})</span>
                  <span>latency: {{ "%.1f"|format(row.candidate.latency_ms) }} ms</span>
                </div>
                <details {% if row.has_issue %}open{% endif %}>
                  <summary>Inspect thought, arguments &amp; observation</summary>
                  {% if row.candidate.thought %}
                    <div class="detail-block">
                      <div class="detail-label">Thought</div>
                      <div class="thought-box">{{ row.candidate.thought }}</div>
                    </div>
                  {% endif %}
                  {% if row.candidate.tool_name %}
                    <div class="detail-block">
                      <div class="detail-label">Action Arguments</div>
                      <pre>{{ row.candidate.arguments_pretty }}</pre>
                    </div>
                  {% endif %}
                  {% if row.candidate.observation %}
                    <div class="detail-block">
                      <div class="detail-label">
                        Observation
                        {% if row.candidate.observation.is_error %}({{ row.candidate.observation.error_type or 'ERROR' }}){% endif %}
                        {% if row.candidate.observation.is_mocked %}(MOCKED){% endif %}
                        {% if row.candidate.observation.is_replayed %}(REPLAYED){% endif %}
                      </div>
                      <pre>{{ row.candidate.observation_pretty }}</pre>
                    </div>
                  {% endif %}
                </details>
              </div>
            {% else %}
              <div class="step-card empty-slot">No corresponding Candidate step</div>
            {% endif %}
          </div>
        {% endfor %}
      {% else %}
        {% for item in single_rows %}
          <div class="timeline-row single-col {% if item.is_fork_point %}fork-point{% endif %}"
               data-has-issue="{{ 'true' if item.has_issue or item.is_fork_point else 'false' }}"
               data-is-mocked="{{ 'true' if item.is_mocked else 'false' }}"
               data-is-replayed="{{ 'true' if item.is_replayed else 'false' }}"
               data-is-fork="{{ 'true' if item.is_fork_point else 'false' }}">
            {% if item.is_fork_point %}
              {{ fork_banner(item.step.step_id, true, false) }}
            {% endif %}
            <div class="step-card {% if item.has_issue %}diverged{% endif %}">
              <div class="step-top">
                <span class="step-id">Step {{ item.step.step_id }} &bull; {{ item.step.state }}</span>
                <div class="step-badges">
                  {% if item.step.tool_name %}
                    <span class="badge badge-info">{{ item.step.tool_name }}</span>
                  {% endif %}
                  {% if item.is_loop_step %}
                    <span class="badge badge-fail">LOOP DETECTED</span>
                  {% elif item.is_failed %}
                    <span class="badge badge-fail">ASSERTION FAIL</span>
                  {% endif %}
                  {% if item.is_fork_point %}
                    <span class="badge badge-fork">FORK POINT ⚡</span>
                  {% endif %}
                  {{ obs_badges(item.step.observation) }}
                </div>
              </div>
              <div class="step-meta">
                <span>tokens: {{ item.step.tokens.total_tokens }}</span>
                <span>latency: {{ "%.1f"|format(item.step.latency_ms) }} ms</span>
              </div>
              <details {% if item.has_issue %}open{% endif %}>
                <summary>Inspect thought, arguments &amp; observation</summary>
                {% if item.step.thought %}
                  <div class="detail-block">
                    <div class="detail-label">Thought</div>
                    <div class="thought-box">{{ item.step.thought }}</div>
                  </div>
                {% endif %}
                {% if item.step.tool_name %}
                  <div class="detail-block">
                    <div class="detail-label">Action Arguments</div>
                    <pre>{{ item.step.arguments_pretty }}</pre>
                  </div>
                {% endif %}
                {% if item.step.observation %}
                  <div class="detail-block">
                    <div class="detail-label">
                      Observation
                      {% if item.step.observation.is_error %}({{ item.step.observation.error_type or 'ERROR' }}){% endif %}
                      {% if item.step.observation.is_mocked %}(MOCKED){% endif %}
                      {% if item.step.observation.is_replayed %}(REPLAYED){% endif %}
                    </div>
                    <pre>{{ item.step.observation_pretty }}</pre>
                  </div>
                {% endif %}
              </details>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </section>
  </div>

  <script>
    function toggleAllDetails(openState) {
      document.querySelectorAll('details').forEach(function (el) {
        el.open = openState;
      });
    }

    function filterRows(mode) {
      var buttons = {
        all: document.getElementById('btn-filter-all'),
        issues: document.getElementById('btn-filter-issues'),
        mocked: document.getElementById('btn-filter-mocked'),
        replayed: document.getElementById('btn-filter-replayed'),
        fork: document.getElementById('btn-filter-fork')
      };
      Object.keys(buttons).forEach(function (key) {
        if (buttons[key]) {
          buttons[key].classList.toggle('active', key === mode);
        }
      });

      var attrMap = {
        issues: 'hasIssue',
        mocked: 'isMocked',
        replayed: 'isReplayed',
        fork: 'isFork'
      };

      document.querySelectorAll('.timeline-row').forEach(function (row) {
        if (mode === 'all') {
          row.classList.remove('hidden');
          return;
        }
        var attr = attrMap[mode];
        if (attr && row.dataset[attr] !== 'true') {
          row.classList.add('hidden');
        } else {
          row.classList.remove('hidden');
        }
      });
    }
  </script>
</body>
</html>
